# Copy to .env.local and fill in. None of these are required to run `next dev` —
# without RESEND_API_KEY the contact form degrades to a mailto: link.

# https://resend.com/api-keys — server-only, never prefixed with NEXT_PUBLIC_
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=kien.nt112002@gmail.com

# Verified sender domain in Resend. Resend's shared sandbox sender is
# onboarding@resend.dev, which only delivers to your own account email.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Absolute site origin, no trailing slash. Used for canonical URLs, hreflang,
# sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
