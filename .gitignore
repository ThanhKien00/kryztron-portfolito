# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor and agent tooling — every dot-directory, at any depth.
# `.github/` is exempt because CI configuration belongs in the repository.
.*/
!.github/

# agent instructions and lock files. README.md is the project's own page and
# stays tracked; these three are local assistant configuration.
AGENTS.md
CLAUDE.md
MEMORY.md
skills-lock.json
